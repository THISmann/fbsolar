generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Category {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}
model Product {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String
  price       Decimal  @db.Decimal(12, 2)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  images      String[]
  /// PRODUCT = catalogue boutique · PROJECT = réalisation / chantier
  kind        String   @default("PRODUCT")
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  socialPublications SocialPublication[]

  @@index([kind, published])
}

enum SocialNetwork {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
}

enum SocialPublishStatus {
  PENDING
  PUBLISHED
  FAILED
}

/// Outbound social posts for PROJECT realizations (multi-network ready).
model SocialPublication {
  id             String              @id @default(uuid())
  productId      String
  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  network        SocialNetwork
  status         SocialPublishStatus @default(PENDING)
  externalPostId String?
  error          String?
  requestedBy    String?
  attempts       Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([productId, network])
  @@index([status, createdAt])
}
model Article {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  content   String
  published Boolean  @default(false)
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
/// CMS pages editable from the admin dashboard (JSON payload).
model SitePage {
  key       String   @id
  title     String
  data      Json
  updatedAt DateTime @updatedAt
}
