          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Marie Martin\",\n  \"email\": \"marie@example.com\",\n  \"message\": \"Question sur les batteries de stockage domestique.\"\n}" },
            "url": "{{base_proxy}}/api/interaction/contact"
