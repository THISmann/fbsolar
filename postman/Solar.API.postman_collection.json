{
  "info": {
    "_postman_id": "solar-api-full-001",
    "name": "Solar API",
    "description": "Collection complète Solar Platform (Traefik).\n\n**Compte seed (ALLOW_DEV_SEED)**\n- email: `admin@solar.local`\n- password: `Admin123!Secure` (BOOTSTRAP_ADMIN_PASSWORD)\n\n**Flux**\n1. Health → Auth (login/me/register/refresh)\n2. Catalog / Media / Interaction\n3. Logout en dernier\n\nRespect OWASP : JWT sur media + chat history admin ; pas de `role` sur register public.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_gateway", "value": "http://localhost" },
    { "key": "base_auth", "value": "http://localhost/api/auth" },
    { "key": "base_catalog", "value": "http://localhost/api/catalog" },
    { "key": "base_media", "value": "http://localhost/api/media" },
    { "key": "base_interaction", "value": "http://localhost/api/interaction" },
    { "key": "base_proxy", "value": "http://localhost" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "product_id", "value": "" },
    { "key": "product_slug", "value": "home-solar-kit" },
    { "key": "article_id", "value": "" },
    { "key": "article_slug", "value": "getting-started-with-solar" },
    { "key": "category_id", "value": "" },
    { "key": "category_slug", "value": "" },
    { "key": "media_id", "value": "" },
    { "key": "visitor_id", "value": "11111111-1111-4111-8111-111111111111" },
    { "key": "run_id", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const id = Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 8);",
          "pm.request.headers.upsert({ key: 'X-Request-Id', value: id });",
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });",
          "if (!pm.collectionVariables.get('run_id')) {",
          "  pm.collectionVariables.set('run_id', Date.now().toString(36));",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Temps < 5s', () => pm.expect(pm.response.responseTime).to.be.below(5000));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Auth health",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('auth', () => pm.expect(pm.response.json().service).to.eql('service-auth'));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{base_auth}}/health" }
        },
        {
          "name": "Catalog health",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{base_catalog}}/health" }
        },
        {
          "name": "Media health",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{base_media}}/health" }
        },
        {
          "name": "Interaction health",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{base_interaction}}/health" }
        },
        {
          "name": "Proxy auth health",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{base_proxy}}/api/auth/health" }
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login admin",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('tokens', () => {",
            "  pm.expect(b.accessToken).to.be.a('string');",
            "  pm.expect(b.refreshToken).to.be.a('string');",
            "});",
            "pm.collectionVariables.set('access_token', b.accessToken);",
            "pm.collectionVariables.set('refresh_token', b.refreshToken);",
            "pm.environment.set('access_token', b.accessToken);",
            "pm.environment.set('refresh_token', b.refreshToken);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@solar.local\",\n  \"password\": \"Admin123!Secure\"\n}" },
            "url": "{{base_auth}}/login"
          }
        },
        {
          "name": "Login via Traefik",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "if (b.accessToken) {",
            "  pm.collectionVariables.set('access_token', b.accessToken);",
            "  pm.environment.set('access_token', b.accessToken);",
            "}",
            "if (b.refreshToken) {",
            "  pm.collectionVariables.set('refresh_token', b.refreshToken);",
            "  pm.environment.set('refresh_token', b.refreshToken);",
            "}"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@solar.local\",\n  \"password\": \"Admin123!Secure\"\n}" },
            "url": "{{base_proxy}}/api/auth/login"
          }
        },
        {
          "name": "Me",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('admin', () => pm.expect(pm.response.json().role).to.eql('ADMIN'));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_auth}}/me"
          }
        },
        {
          "name": "Register user",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 or 409', () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@solar.local\",\n  \"password\": \"User1234!Secure\"\n}" },
            "url": "{{base_auth}}/register"
          }
        },
        {
          "name": "Refresh",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "if (b.accessToken) {",
            "  pm.collectionVariables.set('access_token', b.accessToken);",
            "  pm.environment.set('access_token', b.accessToken);",
            "}",
            "if (b.refreshToken) {",
            "  pm.collectionVariables.set('refresh_token', b.refreshToken);",
            "  pm.environment.set('refresh_token', b.refreshToken);",
            "}"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}" },
            "url": "{{base_auth}}/refresh"
          }
        }
      ]
    },
    {
      "name": "2. Catalog",
      "item": [
        {
          "name": "List categories",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('array', () => pm.expect(pm.response.json()).to.be.an('array'));",
            "const items = pm.response.json();",
            "if (Array.isArray(items) && items[0]?.id) pm.collectionVariables.set('category_id', items[0].id);"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{base_catalog}}/categories" }
        },
        {
          "name": "Create category (ADMIN)",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "const slug = 'cat-' + pm.collectionVariables.get('run_id');",
              "pm.collectionVariables.set('category_slug', slug);",
              "pm.request.body.raw = JSON.stringify({ name: 'Category ' + slug, slug });"
            ]}},
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('200/201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "const b = pm.response.json();",
              "if (b.id) pm.collectionVariables.set('category_id', b.id);"
            ]}}
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{base_catalog}}/categories"
          }
        },
        {
          "name": "List products",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('items array', () => pm.expect(b.items).to.be.an('array'));",
            "pm.test('total number', () => pm.expect(b.total).to.be.a('number'));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_catalog}}/products?page=1&limit=10"
          }
        },
        {
          "name": "Create product (ADMIN)",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "const slug = 'prod-' + pm.collectionVariables.get('run_id');",
              "pm.collectionVariables.set('product_slug', slug);",
              "pm.request.body.raw = JSON.stringify({",
              "  name: 'Product ' + slug,",
              "  slug,",
              "  description: 'Generated by Postman/Newman',",
              "  price: 199.99,",
              "  categoryId: pm.collectionVariables.get('category_id'),",
              "  images: [],",
              "  published: true",
              "});"
            ]}},
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('200/201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "const b = pm.response.json();",
              "if (b.id) pm.collectionVariables.set('product_id', b.id);",
              "if (b.slug) pm.collectionVariables.set('product_slug', b.slug);"
            ]}}
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{base_catalog}}/products"
          }
        },
        {
          "name": "Get product by slug",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{base_catalog}}/products/{{product_slug}}" }
        },
        {
          "name": "List articles",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{base_catalog}}/articles" }
        },
        {
          "name": "Create article (ADMIN)",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "const slug = 'art-' + pm.collectionVariables.get('run_id');",
              "pm.collectionVariables.set('article_slug', slug);",
              "pm.request.body.raw = JSON.stringify({",
              "  title: 'Article ' + slug,",
              "  slug,",
              "  content: 'Contenu généré pour les tests Postman.',",
              "  published: true,",
              "  tags: ['test', 'newman']",
              "});"
            ]}},
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('200/201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "const b = pm.response.json();",
              "if (b.id) pm.collectionVariables.set('article_id', b.id);",
              "if (b.slug) pm.collectionVariables.set('article_slug', b.slug);"
            ]}}
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{base_catalog}}/articles"
          }
        },
        {
          "name": "Get article by slug",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{base_catalog}}/articles/{{article_slug}}" }
        },
        {
          "name": "Products via Traefik",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{base_proxy}}/api/catalog/products" }
        }
      ]
    },
    {
      "name": "3. Media",
      "item": [
        {
          "name": "Upload image",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200/201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
            "const b = pm.response.json();",
            "if (b.id) pm.collectionVariables.set('media_id', b.id);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "fixtures/test.png",
                  "description": "PNG fixture (<10MB, magic-bytes validés)"
                }
              ]
            },
            "url": "{{base_media}}/upload"
          }
        },
        {
          "name": "Get presigned URL",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('url', () => pm.expect(pm.response.json().url).to.be.a('string'));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_media}}/{{media_id}}"
          }
        },
        {
          "name": "Delete media (ADMIN)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_media}}/{{media_id}}"
          }
        }
      ]
    },
