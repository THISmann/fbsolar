{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Solar Platform — Microservices",
    "description": "Tests smoke / health pour les 5 micro-services NestJS (accès direct + via Traefik).\n\nPrérequis : `docker compose up -d`\n\nImporter aussi l'environnement `Solar.local.postman_environment.json`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "auth_url",
      "value": "http://localhost:3001"
    },
    {
      "key": "catalog_url",
      "value": "http://localhost:3002"
    },
    {
      "key": "media_url",
      "value": "http://localhost:3003"
    },
    {
      "key": "interaction_url",
      "value": "http://localhost:3004"
    },
    {
      "key": "traefik_url",
      "value": "http://localhost"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Correlation ID pour tracer les requêtes",
          "const id = Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);",
          "pm.request.headers.upsert({ key: 'X-Request-Id', value: id });"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response time < 2000ms', function () {",
          "  pm.expect(pm.response.responseTime).to.be.below(2000);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 — Smoke Collection",
      "description": "Lancer ce dossier en Runner pour valider tout le stack d'un coup.",
      "item": [
        {
          "name": "All services healthy (direct)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('status === ok', () => pm.expect(body.status).to.eql('ok'));",
                  "pm.test('service name present', () => pm.expect(body.service).to.be.a('string'));",
                  "pm.test('uptime is number', () => pm.expect(body.uptime).to.be.a('number'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_url}}/health",
            "description": "Point d'entrée smoke — le Runner enchaîne les autres requêtes du dossier."
          }
        }
      ]
    },
    {
      "name": "01 — API Gateway (:3000)",
      "item": [
        {
          "name": "GET / — service info",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('service is api-gateway', () => pm.expect(body.service).to.eql('api-gateway'));",
                  "pm.test('message contains running', () => pm.expect(body.message).to.include('running'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_url}}/"
          }
        },
        {
          "name": "GET /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Health OK', () => {",
                  "  pm.expect(body.status).to.eql('ok');",
                  "  pm.expect(body.service).to.eql('api-gateway');",
                  "  pm.expect(body.timestamp).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_url}}/health"
          }
        },
        {
          "name": "GET /health/live",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Liveness OK', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_url}}/health/live"
          }
        },
        {
