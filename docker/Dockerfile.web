# syntax=docker/dockerfile:1.7
# Solar Web — Vite React SPA (build) + nginx (serve)

ARG NODE_VERSION=20

FROM node:${NODE_VERSION}-alpine AS prune
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps

RUN pnpm dlx turbo@2.11.2 prune "@solar/web" --docker

FROM node:${NODE_VERSION}-alpine AS build
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

COPY --from=prune /app/out/json/ ./
RUN pnpm install --frozen-lockfile

COPY --from=prune /app/out/full/ ./
COPY turbo.json tsconfig.base.json ./

ARG VITE_API_BASE=http://localhost
ENV VITE_API_BASE=${VITE_API_BASE}

RUN pnpm turbo run build --filter="@solar/web..."

FROM nginx:1.27-alpine AS runner
RUN apk add --no-cache curl
COPY docker/nginx/web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=15s --timeout=5s --retries=5 --start-period=10s \
  CMD curl -fsS http://127.0.0.1/index.html >/dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
