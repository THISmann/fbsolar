# =============================================================================
# Solar Platform — Environment variables (copy to .env)
# NEVER commit real secrets. Rotate all defaults before production.
# =============================================================================

NODE_ENV=development
SWAGGER_ENABLED=true
ALLOW_DEV_SEED=true
BOOTSTRAP_ADMIN_EMAIL=admin@solar.local
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_unique_12_plus_character_password

# --- Traefik ---
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8088

# --- PostgreSQL ---
POSTGRES_USER=solar
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=solar
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=replace_with_a_strong_redis_password
REDIS_PORT=6379

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace_with_a_strong_minio_password
MINIO_BUCKET=solar-assets
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- RabbitMQ ---
RABBITMQ_USER=solar
RABBITMQ_PASSWORD=replace_with_a_strong_rabbitmq_password
RABBITMQ_VHOST=solar
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- JWT (required, unique, at least 48 random characters each) ---
JWT_ACCESS_SECRET=replace_with_at_least_48_random_characters_for_access_tokens
JWT_REFRESH_SECRET=replace_with_at_least_48_random_characters_for_refresh_tokens

# --- Service host ports ---
API_GATEWAY_PORT=3000
SERVICE_AUTH_PORT=3001
SERVICE_CATALOG_PORT=3002
SERVICE_MEDIA_PORT=3003
SERVICE_INTERACTION_PORT=3004

# --- Captcha (Étape 6) ---
TURNSTILE_SECRET_KEY=
HCAPTCHA_SECRET_KEY=

# --- CORS (Étape 7) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# --- Frontend (web container) ---
WEB_PORT=5173
VITE_API_BASE=http://localhost

# --- Public site (social captions / OG links) ---
PUBLIC_SITE_URL=http://localhost:5173

# --- Facebook Page publishing (service-catalog) ---
# Create a Meta app, grant pages_manage_posts on your business Page,
# then paste a long-lived Page access token (never commit real values).
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v21.0
